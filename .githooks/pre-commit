#!/bin/sh
#
# MingGoRTS Pre-commit Hook
# 本地預提交檢查腳本
#
# 安裝方法:
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-commit
#

# 顏色定義
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "========================================"
echo "Running pre-commit checks..."
echo "執行預提交檢查..."
echo "========================================"

# 檢查是否直接提交到 main 分支
current_branch=$(git symbolic-ref --short HEAD)
if [ "$current_branch" = "main" ]; then
    echo "${RED}❌ Error: Direct commits to 'main' branch are not allowed!${NC}"
    echo "${YELLOW}Please create a feature branch and submit a Pull Request.${NC}"
    echo ""
    echo "Quick fix:"
    echo "  git checkout -b feature/your-feature-name"
    echo "  git push origin feature/your-feature-name"
    exit 1
fi

# 檢查是否直接提交到 develop 分支（可選）
if [ "$current_branch" = "develop" ]; then
    echo "${YELLOW}⚠️  Warning: You are committing directly to 'develop' branch.${NC}"
    read -p "Are you sure? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

# 獲取將要提交的文件的列表
files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(h|cpp)$' || true)

if [ -z "$files" ]; then
    echo "${GREEN}✓ No C++ files to check${NC}"
else
    echo "Checking $($files | wc -l) C++ file(s)..."
    
    # 檢查每個文件
    errors=0
    warnings=0
    
    for file in $files; do
        # 檢查文件是否存在（可能已被刪除）
        if [ ! -f "$file" ]; then
            continue
        fi
        
        # 檢查 1: 亂碼字符（基本檢查）
        if grep -q '' "$file" 2>/dev/null; then
            echo "${RED}❌ $file: Contains invalid characters (encoding issue)${NC}"
            errors=$((errors + 1))
        fi
        
        # 檢查 2: 行尾空格
        if grep -n '[[:space:]]$' "$file" > /dev/null 2>&1; then
            echo "${YELLOW}⚠️  $file: Contains trailing whitespace${NC}"
            warnings=$((warnings + 1))
        fi
        
        # 檢查 3: 制表符（建議使用空格）
        if grep -n $'\t' "$file" > /dev/null 2>&1; then
            echo "${YELLOW}⚠️  $file: Contains tabs (recommend 4 spaces)${NC}"
            warnings=$((warnings + 1))
        fi
        
        # 檢查 4: 頭文件規範
        if echo "$file" | grep -q '\.h$'; then
            # 檢查 #pragma once
            if ! grep -q '#pragma once' "$file" 2>/dev/null; then
                # 檢查是否有 include guard
                if ! grep -q '#ifndef' "$file" 2>/dev/null || ! grep -q '#define' "$file" 2>/dev/null; then
                    echo "${YELLOW}⚠️  $file: Missing #pragma once or include guard${NC}"
                    warnings=$((warnings + 1))
                fi
            fi
            
            # 檢查 UE5 宏（僅適用於特定頭文件）
            if grep -q 'UCLASS\|USTRUCT\|UINTERFACE' "$file" 2>/dev/null; then
                if ! grep -q 'GENERATED_BODY' "$file" 2>/dev/null; then
                    echo "${RED}❌ $file: Missing GENERATED_BODY() for UCLASS/USTRUCT${NC}"
                    errors=$((errors + 1))
                fi
            fi
        fi
        
        # 檢查 5: 文件末尾換行
        if [ -s "$file" ]; then
            last_char=$(tail -c 1 "$file" | od -An -tx1 | tr -d ' ')
            if [ "$last_char" != "0a" ]; then
                echo "${YELLOW}⚠️  $file: Missing newline at end of file${NC}"
                warnings=$((warnings + 1))
            fi
        fi
    done
    
    echo ""
    if [ $errors -gt 0 ]; then
        echo "${RED}Found $errors error(s)${NC}"
    fi
    if [ $warnings -gt 0 ]; then
        echo "${YELLOW}Found $warnings warning(s)${NC}"
    fi
    
    # 如果有錯誤，阻止提交
    if [ $errors -gt 0 ]; then
        echo ""
        echo "${RED}❌ Pre-commit checks failed!${NC}"
        echo "Please fix the errors above before committing."
        echo ""
        echo "To bypass (not recommended):"
        echo "  git commit --no-verify"
        exit 1
    fi
fi

# 檢查 commit message 格式
echo ""
echo "Checking commit message format..."
commit_msg_file="$1"
if [ -f "$commit_msg_file" ]; then
    commit_msg=$(head -n 1 "$commit_msg_file")
    
    # 檢查 Conventional Commits 格式
    valid_types="feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert"
    if ! echo "$commit_msg" | grep -qE "^($valid_types)(\([^)]*\))?: .+"; then
        echo "${RED}❌ Invalid commit message format!${NC}"
        echo ""
        echo "Commit message must follow Conventional Commits:"
        echo "  <type>(<scope>): <subject>"
        echo ""
        echo "Valid types: $valid_types"
        echo ""
        echo "Examples:"
        echo "  feat(sage): implement three authority system"
        echo "  fix(ai): resolve image generation timeout"
        echo "  docs: update README"
        exit 1
    fi
    
    # 檢查標題長度
    msg_length=${#commit_msg}
    if [ $msg_length -gt 100 ]; then
        echo "${YELLOW}⚠️  Commit message too long ($msg_length > 100 chars)${NC}"
    fi
    
    echo "${GREEN}✓ Commit message format valid${NC}"
fi

# 運行快速語法檢查（如果存在 PowerShell 腳本）
if [ -f "Tools/build/QuickSyntaxCheck.ps1" ]; then
    echo ""
    echo "Running quick syntax check..."
    if ! pwsh -Command "& './Tools/build/QuickSyntaxCheck.ps1' -QuickMode" 2>/dev/null; then
        echo "${YELLOW}⚠️  Quick syntax check found issues${NC}"
        # 僅警告，不阻止提交
    else
        echo "${GREEN}✓ Quick syntax check passed${NC}"
    fi
fi

# 總結
echo ""
echo "========================================"
if [ $warnings -gt 0 ]; then
    echo "${YELLOW}⚠️  Pre-commit checks completed with $warnings warning(s)${NC}"
    echo "Commit will proceed, but please review warnings above."
else
    echo "${GREEN}✅ All pre-commit checks passed!${NC}"
fi
echo "========================================"

exit 0
