# Potato Engine Git ignore

# Compiled binary files
*.dll
*.exe
*.so
*.dylib
*.o
*.obj
*.pdb
*.ilk
*.log
*.vspscc
*.vssscc
*_i.c
*_p.c
*.idb
*.suo
*.user
*.sln
*.vcxproj*
*.vcproj*
*.ncb
*.opensdf
*.sdf
*.sln.docstates
*.cache
*.pfx

# CMake build outputs
build/
build-mingw/
CMakeFiles/
CMakeCache.txt
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
*.cmake

# CMake build directories
bin/
lib/
*.a
*.lib

# Rider/Visual Studio
.idea/
.vscode/
.vs/
*.sln.iml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.orig

# Secrets & credentials - NEVER commit these
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.keystore
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.asc
*.gpg
credentials*
secrets.*
*.secret
*.token

# Crash reports
*.crashdump
*.dmp

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Potato Engine specific
Logs/
TestReports/
Generated/
Temp/
Backup_*

# Allow specific JSON files
!tasks.json
!**/tasks.json

# Allow GitHub config files
!.github/**/*.json
!.github/**/*.yml
!.github/**/*.md
# 演示程式執行輸出（replay/roster 等）
duanqiao_replay.json
duanqiao_roster.json
*_replay.json
*_roster.json
audiotest_*.wav

# VRM avatar binaries (downloaded from github.com/tary159951123/my-vrm-models*)
# 正典目錄為 assets/avatars/（已入版控的三支模型）；assets/vrm/ 是重複副本，
# 已移除並忽略以防再次誤存
assets/avatars/
assets/vrm/
Testing/

# SynthDataDemo 產生的訓練資料集（量大可再生，不入版控）
output/synth_dataset/

# PortraitRenderer 產生的立繪輸出（可再生）
output/portraits/

# Java services: Maven build output and embedded H2 database files
services/**/target/
services/data/

# VrmLoadTest/訓練管線產生的資料集（可再生）
output/vrm_dataset/

# 臨時 patch/除錯檔
*.patch
nul
